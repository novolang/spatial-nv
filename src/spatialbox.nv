// spatialbox.nv — a box is plain numbers, and every tree in this
// package is built out of the algebra on this page.
//
// WHAT A BOX IS.  Two corners: a lower bound and an upper bound on
// each axis.  Two numbers per axis, and nothing else — no coordinate
// system, no units, no projection, no notion of what the numbers mean.
// An axis-aligned bounding box in the literature, and the reason every
// spatial index is built on one is that the two questions a tree has
// to answer about a subtree — could anything in here overlap that, and
// how close could anything in here be — are both cheap on a box and
// expensive on the shape the box stands for.
//
// THE DISTANCES HERE ARE PLANAR.  Coordinates are treated as points in
// a flat space and distance is the ordinary Euclidean one.  Nothing on
// this page knows about the curvature of anything.  A caller indexing
// longitude and latitude is welcome — that is the intended use — but
// must know what it is getting: a degree of longitude is a different
// distance at the equator and at 60 degrees north, so a nearest-
// neighbour result in degrees is not a nearest-neighbour result in
// metres away from the equator, and a box that spans the antimeridian
// has a lower bound above its upper bound and is refused here as a
// malformed box.  The README's rules section says what to do about
// both.
//
// EVERY OPERATION THAT COMPARES TWO BOXES IS FALLIBLE.  Not because
// comparing boxes is hard, but because two boxes of different
// dimensions cannot be compared at all, and the alternative to
// refusing is to compare the axes they have in common and answer
// confidently about the wrong thing.  `SpatialDimensionMismatch`
// carries both dimensions, because the usual cause is that one of the
// two came from a different data set than the reader thought.
//
// THE OPERATIONS THAT CANNOT FAIL SAY SO BY NOT RETURNING A `Result`.
// `area`, `margin`, `centre` and `dimension` look at one box and
// answer.  A caller can see which is which from the signature, which
// is the point of writing them differently.

// A position: one coordinate per axis.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.point([3.0, 4.0])
//         Ok(p)  => println("${spatialbox.point_dimension(p)}")   // 2
//         Err(e) => println(e.message())
// ```
pub struct SpatialPoint
    // The coordinates, one per axis, in the caller's own order and
    // the caller's own units.  Never empty.
    coords: [Float]

// An axis-aligned box: a lower and an upper bound on every axis.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [2.0, 3.0])
//         Ok(b)  => println("${spatialbox.area(b)}")   // 6
//         Err(e) => println(e.message())
// ```
pub struct SpatialBox
    // The lower bound on each axis.  Same length as `upper`, and no
    // element above the matching one in it.
    lower: [Float]
    // The upper bound on each axis.
    upper: [Float]

// A point from its coordinates.
//
// `SpatialEmptyDimension` when the list is empty, because there is no
// zero-dimensional space to index.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.point([1.0, 2.0, 3.0])
//         Ok(p)  => println("${spatialbox.point_dimension(p)}")   // 3
//         Err(e) => println(e.message())
// ```
pub fn point(coords: [Float]) -> Result<SpatialPoint, SpatialFault>
    todo("spatial-nv.spatialbox.point")

// A box from its two corners.
//
// `SpatialBadBox` when a lower bound is above its upper bound, naming
// the axis and carrying both numbers; `SpatialDimensionMismatch` when
// the two lists are different lengths; `SpatialEmptyDimension` when
// they are both empty.
//
// A box with a lower bound EQUAL to its upper bound on some axis is
// fine: that is a box of no width on that axis, which is what a line
// segment's bounding box looks like and what a point's does on every
// axis.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [1.0, 1.0])
//         Ok(b)  => println("${spatialbox.area(b)}")   // 1
//         Err(e) => println(e.message())
// ```
pub fn box_of(lower: [Float], upper: [Float]) -> Result<SpatialBox, SpatialFault>
    todo("spatial-nv.spatialbox.box_of")

// The box of no width around a point.
//
// Its lower and upper corners are both the point, so its area is zero
// and it contains exactly that point.  It is how a point goes into an
// R-tree, which keys everything by a box.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.point([1.0, 2.0])
//         Err(e) => println(e.message())
//         Ok(p)  => println("${spatialbox.area(spatialbox.box_around(p))}")   // 0
// ```
pub fn box_around(p: SpatialPoint) -> SpatialBox
    todo("spatial-nv.spatialbox.box_around")

// How many axes this box has.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [1.0, 1.0])
//         Ok(b)  => println("${spatialbox.dimension(b)}")   // 2
//         Err(e) => println(e.message())
// ```
pub fn dimension(b: SpatialBox) -> Int
    todo("spatial-nv.spatialbox.dimension")

// How many axes this point has.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.point([1.0, 2.0])
//         Ok(p)  => println("${spatialbox.point_dimension(p)}")   // 2
//         Err(e) => println(e.message())
// ```
pub fn point_dimension(p: SpatialPoint) -> Int
    todo("spatial-nv.spatialbox.point_dimension")

// The smallest box holding both of these.
//
// The operation every branch of an R-tree is built out of: a node's
// box is the union of its children's.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [1.0, 1.0])
//         Err(e) => println(e.message())
//         Ok(a)  =>
//             match spatialbox.box_of([2.0, 2.0], [3.0, 3.0])
//                 Err(e) => println(e.message())
//                 Ok(b)  =>
//                     match spatialbox.union(a, b)
//                         Ok(u)  => println("${spatialbox.area(u)}")   // 9
//                         Err(e) => println(e.message())
// ```
pub fn union(a: SpatialBox, b: SpatialBox) -> Result<SpatialBox, SpatialFault>
    todo("spatial-nv.spatialbox.union")

// The box the two have in common, or `None` when they have none.
//
// `None` rather than a box of negative width, because a box of
// negative width is not a box and every caller would have to check for
// it anyway.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [2.0, 2.0])
//         Err(e) => println(e.message())
//         Ok(a)  =>
//             match spatialbox.box_of([1.0, 1.0], [3.0, 3.0])
//                 Err(e) => println(e.message())
//                 Ok(b)  =>
//                     match spatialbox.intersection(a, b)
//                         Err(e)      => println(e.message())
//                         Ok(None)    => println("disjoint")
//                         Ok(Some(i)) => println("${spatialbox.area(i)}")   // 1
// ```
pub fn intersection(a: SpatialBox, b: SpatialBox) -> Result<?SpatialBox, SpatialFault>
    todo("spatial-nv.spatialbox.intersection")

// Whether the two boxes share any point at all.
//
// Touching counts: two boxes that meet exactly at a face overlap,
// because the face belongs to both. That convention matters at a query
// boundary, and the README states it once.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [1.0, 1.0])
//         Err(e) => println(e.message())
//         Ok(a)  =>
//             match spatialbox.box_of([1.0, 0.0], [2.0, 1.0])
//                 Err(e) => println(e.message())
//                 Ok(b)  =>
//                     match spatialbox.overlaps(a, b)
//                         Ok(yes) => println("${yes}")   // true
//                         Err(e)  => println(e.message())
// ```
pub fn overlaps(a: SpatialBox, b: SpatialBox) -> Result<Bool, SpatialFault>
    todo("spatial-nv.spatialbox.overlaps")

// Whether `outer` holds the whole of `inner`.
//
// The test a range query uses to stop descending: a subtree whose box
// is wholly inside the query area needs no further comparisons,
// because every entry under it is a hit.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [4.0, 4.0])
//         Err(e) => println(e.message())
//         Ok(outer) =>
//             match spatialbox.box_of([1.0, 1.0], [2.0, 2.0])
//                 Err(e) => println(e.message())
//                 Ok(inner) =>
//                     match spatialbox.contains_box(outer, inner)
//                         Ok(yes) => println("${yes}")   // true
//                         Err(e)  => println(e.message())
// ```
pub fn contains_box(outer: SpatialBox, inner: SpatialBox) -> Result<Bool, SpatialFault>
    todo("spatial-nv.spatialbox.contains_box")

// Whether this box holds this point.
//
// A point on the boundary is inside, on the same convention as
// `overlaps`.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [2.0, 2.0])
//         Err(e) => println(e.message())
//         Ok(b)  =>
//             match spatialbox.point([1.0, 1.0])
//                 Err(e) => println(e.message())
//                 Ok(p)  =>
//                     match spatialbox.contains_point(b, p)
//                         Ok(yes) => println("${yes}")   // true
//                         Err(e)  => println(e.message())
// ```
pub fn contains_point(b: SpatialBox, p: SpatialPoint) -> Result<Bool, SpatialFault>
    todo("spatial-nv.spatialbox.contains_point")

// The product of the box's widths: its area in two dimensions, its
// volume in three.
//
// Zero for a box of no width on any axis, which is what a point's box
// is. It cannot fail, because it looks at one box.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [2.0, 3.0])
//         Ok(b)  => println("${spatialbox.area(b)}")   // 6
//         Err(e) => println(e.message())
// ```
pub fn area(b: SpatialBox) -> Float
    todo("spatial-nv.spatialbox.area")

// The sum of the box's widths: half its perimeter in two dimensions.
//
// A second measure of how big a box is, and a better one than area
// for choosing between candidate splits — a long thin box and a square
// of the same area behave very differently as a subtree's bound, and
// margin tells them apart where area does not.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [2.0, 3.0])
//         Ok(b)  => println("${spatialbox.margin(b)}")   // 5
//         Err(e) => println(e.message())
// ```
pub fn margin(b: SpatialBox) -> Float
    todo("spatial-nv.spatialbox.margin")

// How much `b` would have to grow in area to hold `addition` as well.
//
// The quantity an R-tree insertion minimises when it chooses which
// subtree to descend into, which is why it is on this page rather than
// hidden inside the tree: a caller can see what the tree is optimising
// and can measure it on its own data.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [1.0, 1.0])
//         Err(e) => println(e.message())
//         Ok(b)  =>
//             match spatialbox.box_of([1.0, 1.0], [2.0, 2.0])
//                 Err(e) => println(e.message())
//                 Ok(extra) =>
//                     match spatialbox.enlargement(b, extra)
//                         Ok(grew) => println("${grew}")   // 3
//                         Err(e)   => println(e.message())
// ```
pub fn enlargement(b: SpatialBox, addition: SpatialBox) -> Result<Float, SpatialFault>
    todo("spatial-nv.spatialbox.enlargement")

// The middle of the box.
//
// What a bulk loader sorts on and what a k-d tree splits at. It cannot
// fail, because it looks at one box.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [2.0, 4.0])
//         Ok(b)  => println("${spatialbox.centre(b).coords}")   // [1, 2]
//         Err(e) => println(e.message())
// ```
pub fn centre(b: SpatialBox) -> SpatialPoint
    todo("spatial-nv.spatialbox.centre")

// The shortest planar distance from this point to any point of this
// box.
//
// Zero when the point is inside or on the boundary. This is the
// quantity every nearest-neighbour search prunes on: a subtree whose
// box is further away than the best hit so far cannot hold a better
// one, so the search never opens it.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [1.0, 1.0])
//         Err(e) => println(e.message())
//         Ok(b)  =>
//             match spatialbox.point([4.0, 5.0])
//                 Err(e) => println(e.message())
//                 Ok(p)  =>
//                     match spatialbox.distance_to_point(b, p)
//                         Ok(d)  => println("${d}")   // 5, the 3-4-5 triangle
//                         Err(e) => println(e.message())
// ```
pub fn distance_to_point(b: SpatialBox, p: SpatialPoint) -> Result<Float, SpatialFault>
    todo("spatial-nv.spatialbox.distance_to_point")

// The planar distance between two points.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.point([0.0, 0.0])
//         Err(e) => println(e.message())
//         Ok(a)  =>
//             match spatialbox.point([3.0, 4.0])
//                 Err(e) => println(e.message())
//                 Ok(b)  =>
//                     match spatialbox.point_distance(a, b)
//                         Ok(d)  => println("${d}")   // 5
//                         Err(e) => println(e.message())
// ```
pub fn point_distance(a: SpatialPoint, b: SpatialPoint) -> Result<Float, SpatialFault>
    todo("spatial-nv.spatialbox.point_distance")

// The shortest planar distance between any point of one box and any
// point of the other.
//
// Zero when they overlap.
//
// ```novo
// use spatialbox
//
// fn main() [io]
//     match spatialbox.box_of([0.0, 0.0], [1.0, 1.0])
//         Err(e) => println(e.message())
//         Ok(a)  =>
//             match spatialbox.box_of([4.0, 0.0], [5.0, 1.0])
//                 Err(e) => println(e.message())
//                 Ok(b)  =>
//                     match spatialbox.box_distance(a, b)
//                         Ok(d)  => println("${d}")   // 3
//                         Err(e) => println(e.message())
// ```
pub fn box_distance(a: SpatialBox, b: SpatialBox) -> Result<Float, SpatialFault>
    todo("spatial-nv.spatialbox.box_distance")
